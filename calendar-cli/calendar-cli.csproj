<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>calendar</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CalendarCli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Packaging configuration for self-contained, single-file executable -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.74.0.4154" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CalendarCli.Tests" />
  </ItemGroup>

</Project>
